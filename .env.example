# Sanity CMS Configuration
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production

# PayHere Configuration (Sandbox)
# Note: VITE_ prefixed vars are exposed to client - only use for non-sensitive data
VITE_PAYHERE_MERCHANT_ID=1228376

# Server-side only (Cloudflare Pages environment variables)
# Set these in Cloudflare Pages dashboard under Settings > Environment Variables:
# PAYHERE_MERCHANT_ID=1228376
# PAYHERE_MERCHANT_SECRET=your_merchant_secret_key